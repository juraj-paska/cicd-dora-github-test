# TEMPLATE ONLY — this file is NOT applied by the pipeline.
#
# The real Secrets are created by the "Create/refresh APM Secrets" step in
# .github/workflows/build.yaml, from encrypted GitHub Actions secrets:
#   SWO_STAGING_INGESTION_TOKEN
#   SWO_DEV_INGESTION_TOKEN
#
# The SW_APM_SERVICE_KEY has the format <ingestion-token>:<service-name>.
# The service name below (cicd-dora-github-test) is a fallback only — each
# workload overrides it per-pod via OTEL_SERVICE_NAME so the deployment,
# statefulset, and daemonset report as distinct services.
#
# To create the Secrets by hand (e.g. for a local cluster) fill in the tokens
# and run:  kubectl apply -f k8s/01-secret.yaml.example
apiVersion: v1
kind: Secret
metadata:
  name: cicd-dora-github-test-website-apm-staging
  namespace: cicd-dora-github-test
  labels:
    app: cicd-dora-github-test-website
    env: staging
type: Opaque
stringData:
  SW_APM_SERVICE_KEY: "<swo-staging-ingestion-token>:cicd-dora-github-test"
---
apiVersion: v1
kind: Secret
metadata:
  name: cicd-dora-github-test-website-apm-dev
  namespace: cicd-dora-github-test
  labels:
    app: cicd-dora-github-test-website
    env: dev
type: Opaque
stringData:
  SW_APM_SERVICE_KEY: "<swo-dev-ingestion-token>:cicd-dora-github-test"
